# --- Slack (required for bot.py; get both from api.slack.com/apps) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...   # app-level token with connections:write (Socket Mode)

# --- Model answers (optional; without it the bot runs in extractive mode) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# --- Ticket system (optional; without it tickets go to tickets-outbox.jsonl) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=helpbot@yourcompany.com
JIRA_API_TOKEN=...
JIRA_PROJECT_KEY=IT
JIRA_ISSUE_TYPE=Task

# --- Paths (optional) ---
# HELPBOT_KB_DIR=./kb
# HELPBOT_LEDGER=./helpbot-ledger.jsonl
